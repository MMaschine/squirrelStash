<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SquirrelStash.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SquirrelStash"
    Shell.FlyoutBehavior="Disabled"
    xmlns:views="clr-namespace:SquirrelStash.Views"
    Title="SquirrelStash">

    <TabBar>
        <Tab x:Name="ThresholdTab" Title="Overview">
            <Shell.TitleView>
                <Label Text="Overview"/>
            </Shell.TitleView>
            <ShellContent Route="MainPage" ContentTemplate="{DataTemplate views:MainPage}"/>
        </Tab>
        <Tab x:Name="TreeTab" Title="Tree">
            <ShellContent Route="MainPage" ContentTemplate="{DataTemplate views:TreePage}"/>
        </Tab>
    </TabBar>
</Shell>
