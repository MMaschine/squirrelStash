<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Color.PageBackground">#F7F3ED</Color>
    <Color x:Key="Color.CardBackground">#FFFFFF</Color>

    <Color x:Key="Color.PrimaryBlue">#2F6F9F</Color>
    <Color x:Key="Color.PrimaryBlueDark">#24597F</Color>
    <Color x:Key="Color.PrimaryBlueBorder">#BCD3E3</Color>

    <Color x:Key="Color.GoldAccent">#C5962F</Color>
    <Color x:Key="Color.GoldSoft">#F2E2B7</Color>
    <Color x:Key="Color.SuccessGreen">#3E8B5B</Color>
    <Color x:Key="Color.SuccessSoft">#D9ECDC</Color>
    <Color x:Key="Color.WarningOrange">#D1862D</Color>
    <Color x:Key="Color.WarningSoft">#F6E2C8</Color>
    <Color x:Key="Color.CriticalRed">#C45454</Color>
    <Color x:Key="Color.CriticalSoft">#F2D6D6</Color>

    <Color x:Key="Color.TextPrimary">#24313C</Color>
    <Color x:Key="Color.TextSecondary">#61707C</Color>

    <Color x:Key="Color.BorderDefault">#D9E3EA</Color>
    <Color x:Key="Color.InputBackground">#FCFAF7</Color>
    <Color x:Key="Color.ImagePlaceholder">#F1EEE8</Color>
    <Color x:Key="Color.ImageSelectorBackground">#E9E3D8</Color>
    <Color x:Key="Color.Overlay">#66F7F3ED</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.PageBackground" Color="{StaticResource Color.PageBackground}" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}" />
    <SolidColorBrush x:Key="Brush.PrimaryBlue" Color="{StaticResource Color.PrimaryBlue}" />
    <SolidColorBrush x:Key="Brush.PrimaryBlueDark" Color="{StaticResource Color.PrimaryBlueDark}" />
    <SolidColorBrush x:Key="Brush.PrimaryBlueBorder" Color="{StaticResource Color.PrimaryBlueBorder}" />
    <SolidColorBrush x:Key="Brush.GoldAccent" Color="{StaticResource Color.GoldAccent}" />
    <SolidColorBrush x:Key="Brush.GoldSoft" Color="{StaticResource Color.GoldSoft}" />
    <SolidColorBrush x:Key="Brush.SuccessGreen" Color="{StaticResource Color.SuccessGreen}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.WarningOrange" Color="{StaticResource Color.WarningOrange}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.CriticalRed" Color="{StaticResource Color.CriticalRed}" />
    <SolidColorBrush x:Key="Brush.CriticalSoft" Color="{StaticResource Color.CriticalSoft}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.BorderDefault" Color="{StaticResource Color.BorderDefault}" />
</ResourceDictionary>
