<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="Size.Corner.Small">10</x:Double>
    <x:Double x:Key="Size.Corner.Medium">12</x:Double>
    <x:Double x:Key="Size.Icon.Round">40</x:Double>
    <x:Double x:Key="Size.Icon.Card">44</x:Double>
    <x:Double x:Key="Size.Icon.Form">46</x:Double>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Color.PageBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Color.PageBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Color.White}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Color.White}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Color.PrimaryBlueBorder}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource Color.PageBackground}" />
        <Setter Property="BarTextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="IconColor" Value="{StaticResource Color.PrimaryBlue}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Color.PrimaryBlue}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Color.BorderDefault}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Color.BorderDefault}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Color.White}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderColor" Value="{StaticResource Color.BorderDefault}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="SeparatorColor" Value="{StaticResource Color.BorderDefault}" />
        <Setter Property="RefreshControlColor" Value="{StaticResource Color.PrimaryBlue}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Color.PrimaryBlue}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Color.PrimaryBlue}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
    </Style>

    <Style x:Key="SurfaceBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource Color.BorderDefault}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
        <Setter Property="Stroke" Value="{StaticResource Color.PrimaryBlueBorder}" />
    </Style>

    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.PrimaryBlueBorder}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="InputContainerStyle" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.InputBackground}" />
    </Style>

    <Style x:Key="H1LabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.PrimaryBlueDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="H2LabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="H3LabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="BodyLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="BodySecondaryLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="BodyStrongLabelStyle" TargetType="Label" BasedOn="{StaticResource BodyLabelStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="IconButtonBaseStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
        <Setter Property="TextColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="RoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
        <Setter Property="WidthRequest" Value="{StaticResource Size.Icon.Round}" />
        <Setter Property="HeightRequest" Value="{StaticResource Size.Icon.Round}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Size.Icon.Round}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Size.Icon.Round}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="SmallRoundToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.InputBackground}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.PrimaryBlueBorder}" />
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumWidthRequest" Value="28" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="CardIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonBaseStyle}">
        <Setter Property="WidthRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="HeightRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Size.Corner.Medium}" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="IconImageButtonBaseStyle" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.PrimaryBlue}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Aspect" Value="AspectFit" />
    </Style>

    <Style x:Key="FormActionButtonStyle" TargetType="ImageButton" BasedOn="{StaticResource IconImageButtonBaseStyle}">
        <Setter Property="WidthRequest" Value="{StaticResource Size.Icon.Form}" />
        <Setter Property="HeightRequest" Value="{StaticResource Size.Icon.Form}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Size.Icon.Form}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Size.Icon.Form}" />
        <Setter Property="CornerRadius" Value="{StaticResource Size.Corner.Small}" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Color.ImagePlaceholder}" />
                            <Setter Property="BorderColor" Value="{StaticResource Color.BorderDefault}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="CategoryAddButtonStyle" TargetType="ImageButton" BasedOn="{StaticResource IconImageButtonBaseStyle}">
        <Setter Property="WidthRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="HeightRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource Size.Icon.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Size.Corner.Medium}" />
    </Style>

    <Style x:Key="CategoryAddItemButtonStyle" TargetType="ImageButton" BasedOn="{StaticResource CategoryAddButtonStyle}">
        <Setter Property="Padding" Value="7" />
    </Style>

    <Style x:Key="ThresholdCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="ThresholdInputStyle" TargetType="Border" BasedOn="{StaticResource InputContainerStyle}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
