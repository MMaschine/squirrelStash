<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SquirrelStash.Views"
             xmlns:viewModels="clr-namespace:SquirrelStash.ViewModels"
             x:Class="SquirrelStash.Views.CategoryCardView"
             x:DataType="viewModels:CategoryCardViewModel">
    <Border
        Padding="12"
        StrokeThickness="1"
        Stroke="#D0D0D0"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 12">

        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="{Binding Title}"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="+"
                    WidthRequest="32"
                    HeightRequest="32"
                    CornerRadius="16"
                    Padding="0"
                    FontSize="18"
                    HorizontalOptions="End"
                    VerticalOptions="Start" 
                    Command="{Binding AddItemCommand}"/>
            </Grid>

            <Border
                Padding="10"
                StrokeThickness="1"
                Stroke="#D8D8D8"
                BackgroundColor="#FAFAFA"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Select Filters"
                            FontSize="14"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Button
                            x:Name="OpenFilterBtn"
                            Grid.Column="1"
                            WidthRequest="22"
                            HeightRequest="22"
                            Padding="0"
                            CornerRadius="11"
                            BackgroundColor="Transparent"
                            BorderWidth="1"
                            BorderColor="#B8B8B8"
                            FontSize="12"
                            TextColor="#4A4A4A"
                            Clicked="OpenFilterOnClicked" />
                    </Grid>

                    <VerticalStackLayout
                        x:Name="FilterPanel"
                        Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Picker
                                Grid.Column="0"
                                Title="Select filter"
                                ItemsSource="{Binding FilterOptions}"
                                SelectedItem="{Binding SelectedFilter}"
                                ItemDisplayBinding="{Binding Name}" />

                            <Picker
                                Grid.Column="1"
                                Title="Enter value"
                                ItemsSource="{Binding SelectedFilterAllowedValues}"
                                SelectedItem="{Binding SelectedAllowedValue}"
                                IsVisible="{Binding IsAllowedValuesFilter}" />

                            <Entry
                                Grid.Column="1"
                                Placeholder="Enter value"
                                Text="{Binding FilterValue}"
                                IsVisible="{Binding IsManualValueFilter}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                        <views:ItemCardView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Border>
</ContentView>
