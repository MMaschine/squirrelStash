<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SquirrelStash.Views"
             xmlns:viewModels="clr-namespace:SquirrelStash.ViewModels"
             xmlns:resources="clr-namespace:SquirrelStash.Resources"
             x:Class="SquirrelStash.Views.CategoryCardView"
             x:DataType="viewModels:CategoryCardViewModel">
    <Border Style="{StaticResource CardBorderStyle}">

        <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="{Binding Title}"
                    Style="{StaticResource H2LabelStyle}"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Text="+"
                    Style="{StaticResource RoundIconButtonStyle}"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Command="{Binding AddItemCommand}" />
            </Grid>

