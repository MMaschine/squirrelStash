                                ItemDisplayBinding="{Binding Name}" />

                            <Picker
                                Grid.Column="1"
                                Title="{x:Static resources:AppText.EnterValuePlaceholder}"
                                ItemsSource="{Binding SelectedFilterAllowedValues}"
                                SelectedItem="{Binding SelectedAllowedValue}"
