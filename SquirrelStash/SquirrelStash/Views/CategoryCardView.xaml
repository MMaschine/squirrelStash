            <Grid ColumnDefinitions="*,Auto"
                  Padding="0,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleItemsVisibilityCommand}" />
                </Grid.GestureRecognizers>

                <Label Text="{Binding ItemsHeaderText}"
                       Style="{StaticResource BodyStrongLabelStyle}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="{Binding ItemsToggleText}"
                        Style="{StaticResource SmallRoundToggleButtonStyle}"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Command="{Binding ToggleItemsVisibilityCommand}" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsItemsVisible}"
                                 Spacing="6">
                <Picker
                    Title="{x:Static resources:AppText.SelectOrderTitle}"
                    ItemsSource="{Binding OrderOption}"
                    SelectedItem="{Binding SelectedOrderOption}"
                    HorizontalOptions="End"
                    WidthRequest="180" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                     Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                            <views:ItemCardView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
