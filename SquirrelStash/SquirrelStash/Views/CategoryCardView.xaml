<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SquirrelStash.Views"
             xmlns:components="clr-namespace:SquirrelStash.Components"
             xmlns:viewModels="clr-namespace:SquirrelStash.ViewModels"
             xmlns:resources="clr-namespace:SquirrelStash.Resources"
             x:Class="SquirrelStash.Views.CategoryCardView"
             x:DataType="viewModels:CategoryCardViewModel">
    <Border Style="{StaticResource CardBorderStyle}">

        <VerticalStackLayout Spacing="12">

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="85*,15*"
                  RowSpacing="8"
                  ColumnSpacing="10">
                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Padding="0,2">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleItemsVisibilityCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Text="{Binding Title}"
                           Style="{StaticResource H2LabelStyle}"
                           VerticalOptions="Center" />
                </Grid>

                <ImageButton Grid.Row="0"
                             Grid.Column="1"
                             Source="edit.png"
                             Style="{StaticResource CategoryAddButtonStyle}"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding EditCategoryCommand}" />

                <HorizontalStackLayout Grid.Row="1"
                                       Grid.Column="0"
                                       Spacing="8"
                                       Padding="0,2"
                                       VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleItemsVisibilityCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>

                    <Label Text="{Binding ItemsHeaderText}"
                           Style="{StaticResource BodyStrongLabelStyle}"
                           VerticalOptions="Center" />

                    <components:ExpandCollapseIndicator IsExpanded="{Binding IsItemsVisible}" />
                </HorizontalStackLayout>

                <ImageButton Grid.Row="1"
                             Grid.Column="1"
                             Source="add_item.png"
                             Style="{StaticResource CategoryAddItemButtonStyle}"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding AddItemCommand}" />
            </Grid>

            <BoxView />

            <VerticalStackLayout IsVisible="{Binding IsItemsVisible}"
                                 Spacing="6">
                <Grid IsVisible="{Binding CanOrderItems}"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Style="{StaticResource OrderPickerContainerStyle}">
                        <Picker
                            x:Name="OrderPicker"
                            Title="{x:Static resources:AppText.SelectOrderTitle}"
                            Style="{StaticResource OrderPickerStyle}"
                            ItemsSource="{Binding OrderOptions}"
                            SelectedItem="{Binding SelectedOrderOption, Mode=TwoWay}"
                            ItemDisplayBinding="{Binding Name}" />
                    </Border>

                    <Button
                        Grid.Column="1"
                        Text="x"
                        Style="{StaticResource OrderClearButtonStyle}"
                        IsVisible="{Binding HasSelectedOrderOption}"
                        VerticalOptions="Center"
                        Command="{Binding ClearOrderSelectionCommand}"
                        Clicked="OnClearOrderButtonClicked" />
                </Grid>

                <VerticalStackLayout Margin="0,4,0,0"
                                     BindableLayout.ItemsSource="{Binding Items}"
                                     Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                            <views:ItemCardView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
