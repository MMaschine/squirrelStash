<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquirrelStash.Views.ConfirmationDialog"
             BackgroundColor="#73000000">

    <Grid Padding="20">
        <BoxView Color="#01000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            Padding="16"
            BackgroundColor="{StaticResource Color.CardBackground}"
            Stroke="{StaticResource Color.PrimaryBlueBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            MaximumWidthRequest="360"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="18">
                <Label
                    x:Name="TitleLabel"
                    Style="{StaticResource H2LabelStyle}"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="MessageLabel"
                    Style="{StaticResource BodyLabelStyle}"
                    LineBreakMode="WordWrap"
                    HorizontalTextAlignment="Center"
                    Margin="4,4,4,8" />

                <HorizontalStackLayout
                    Spacing="10"
                    Margin="0,8,0,0"
                    HorizontalOptions="End">
                    <ImageButton
                        Source="cross.png"
                        Style="{StaticResource FormActionButtonStyle}"
                        Clicked="OnCancelClicked" />

                    <ImageButton
                        Source="apply.png"
                        Style="{StaticResource FormActionButtonStyle}"
                        Clicked="OnApplyClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
