<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:enums="clr-namespace:SquirrelStash.Enums"
             x:Class="SquirrelStash.Views.ItemCardView">
    <Border
        Padding="10">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                <Style.Triggers>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding Status}"
                        Value="{x:Static enums:ItemCardStatus.MissingData}">
                        <Setter Property="Stroke" Value="#E0B12C" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding Status}"
                        Value="{x:Static enums:ItemCardStatus.WarningThresholdReached}">
                        <Setter Property="Stroke" Value="{StaticResource Color.WarningOrange}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding Status}"
                        Value="{x:Static enums:ItemCardStatus.CriticalThresholdReached}">
                        <Setter Property="Stroke" Value="{StaticResource Color.CriticalRed}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid
            ColumnDefinitions="64,*,Auto"
            ColumnSpacing="12"
            VerticalOptions="Center">

            <!-- Image area -->
            <Border
                Grid.Column="0"
                WidthRequest="64"
                HeightRequest="64"
                Style="{StaticResource SurfaceBorderStyle}"
                Padding="0"
                StrokeThickness="1"
                BackgroundColor="{StaticResource Color.ImagePlaceholder}"
                StrokeShape="RoundRectangle 8"
                HorizontalOptions="Start"
                VerticalOptions="Center">

                <Image
                    Source="{Binding ImagePath}"
                    Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowItemDetailsCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Border>

            <!-- Name -->
            <Grid
                Grid.Column="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="6"
                VerticalOptions="Center">

                <Label
                    Text="{Binding Name}"
                    LineBreakMode="WordWrap"
                    MaxLines="3"
                    VerticalOptions="Center"
                    Style="{StaticResource BodyLabelStyle}" />

                <Image
                    Grid.Column="1"
                    Source="warning.png"
                    WidthRequest="20"
                    HeightRequest="20"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasWarning}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditItemCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <!-- Quantity controls -->
            <HorizontalStackLayout
                Grid.Column="2"
                Spacing="8"
                VerticalOptions="Center"
                HorizontalOptions="End">

                <Button
                    Text="-"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Command="{Binding DecreaseQuantityCommand}" />

                <Label
                    Text="{Binding Quantity}"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    WidthRequest="30"
                    Style="{StaticResource H3LabelStyle}" />

                <Button
                    Text="+"
                    Style="{StaticResource RoundIconButtonStyle}"
                    Command="{Binding IncreaseQuantityCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
