<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SquirrelStash.Views.ItemDetailsDialog"
             BackgroundColor="#73000000">

    <Grid Padding="20">
        <BoxView Color="#01000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            Padding="16"
            BackgroundColor="{StaticResource Color.CardBackground}"
            Stroke="{StaticResource Color.PrimaryBlueBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="16">
                <Border
                    WidthRequest="320"
                    HeightRequest="360"
                    BackgroundColor="{StaticResource Color.ImageSelectorBackground}"
                    Stroke="{StaticResource Color.PrimaryBlueBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <Image
                        x:Name="ItemImage"
                        Aspect="AspectFit" />
                </Border>

                <Border
                    WidthRequest="320"
                    Padding="12,8"
                    BackgroundColor="{StaticResource Color.CardBackground}"
                    Stroke="{StaticResource Color.PrimaryBlueBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        x:Name="ItemNameLabel"
                        Style="{StaticResource BodyStrongLabelStyle}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </Border>

                <Grid
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    HorizontalOptions="End">
                    <Button
                        ImageSource="edit.png"
                        Style="{StaticResource CardIconButtonStyle}"
                        Clicked="OnEditClicked" />

                    <Button
                        Grid.Column="1"
                        ImageSource="copy_item.png"
                        Style="{StaticResource CardIconButtonStyle}"
                        Clicked="OnCopyClicked" />

                    <Button
                        Grid.Column="2"
                        ImageSource="delete.png"
                        Style="{StaticResource CardIconButtonStyle}"
                        Clicked="OnDeleteClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
