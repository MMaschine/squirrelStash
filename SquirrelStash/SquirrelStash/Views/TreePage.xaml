<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SquirrelStash.Views"
             x:Class="SquirrelStash.Views.TreePage">

    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <Border Grid.Column="0"
                    Style="{StaticResource InputContainerStyle}"
                    Padding="12,6">
                <Entry Placeholder="Search category"
                       Text="{Binding SearchText, Mode=TwoWay}" />
            </Border>

            <ImageButton Grid.Column="1"
                         Source="add_category.png"
                         Style="{StaticResource CategoryAddButtonStyle}"
                         Command="{Binding CreateCategoryCommand}" />
        </Grid>

        <Grid Grid.Row="1">

            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <views:CategoryCardView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="{StaticResource Color.Overlay}"
                  InputTransparent="False">

                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}" />
                    <Label Text="Loading categories..."
                           Style="{StaticResource BodySecondaryLabelStyle}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
